    {
      "type": "timeseries",
      "title": "RSSI",
      "description": "Daily average signal strength per node. Node 1 is in the bedroom, node 2 at the study desk, node 3 beside the living-room sofa.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', bucket AT TIME ZONE '$tz') AT TIME ZONE '$tz' AS time,\n       'node ' || node_id AS metric,\n       sum(rssi_avg * n) / nullif(sum(n), 0) AS value\nFROM agg.node_1h\nWHERE $__timeFilter(bucket)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
