    {
      "type": "timeseries",
      "title": "Time by room state",
      "description": "Hours of each day the room was still, moving or active (all rows, live or not). One bar per day in the home's time zone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', bucket AT TIME ZONE '$tz') AT TIME ZONE '$tz' AS time,\n       sum(n_still::float / nullif(n, 0)) AS \"still\",\n       sum(n_moving::float / nullif(n, 0)) AS \"moving\",\n       sum(n_active::float / nullif(n, 0)) AS \"active\"\nFROM agg.state_1h\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
