  "panels": [
    {
      "type": "timeseries",
      "title": "Hours with live CSI and hours present",
      "description": "Hours of each day with a live CSI source, and hours with someone present (from the hourly aggregates). One bar per day in the home's time zone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', bucket AT TIME ZONE '$tz') AT TIME ZONE '$tz' AS time,\n       sum(n_live::float / nullif(n, 0)) AS \"live CSI\",\n       sum(presence * n_live / nullif(n, 0)) AS \"present\"\nFROM agg.state_1h\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
