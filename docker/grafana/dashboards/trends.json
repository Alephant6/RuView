    {
      "type": "timeseries",
      "title": "Heart rate, night and day",
      "description": "Average of the hourly median heart rates at night and in the day. Room-level CSI estimate from the hourly medians, weighted by how many values each hour published; nights run 21:00 to 09:00 and count for the day they end. Not a medical measurement.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', bucket AT TIME ZONE '$tz' + interval '3 hours') AT TIME ZONE '$tz' AS time,\n       sum(hr_med * hr_n) FILTER (WHERE extract(hour FROM bucket AT TIME ZONE '$tz') NOT BETWEEN 9 AND 20)\n         / nullif(sum(hr_n) FILTER (WHERE extract(hour FROM bucket AT TIME ZONE '$tz') NOT BETWEEN 9 AND 20), 0) AS \"night\",\n       sum(hr_med * hr_n) FILTER (WHERE NOT extract(hour FROM bucket AT TIME ZONE '$tz') NOT BETWEEN 9 AND 20)\n         / nullif(sum(hr_n) FILTER (WHERE NOT extract(hour FROM bucket AT TIME ZONE '$tz') NOT BETWEEN 9 AND 20), 0) AS \"day\"\nFROM agg.state_1h\nWHERE $__timeFilter(bucket) AND hr_n > 0\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: bpm",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1d",
      "id": 3,
