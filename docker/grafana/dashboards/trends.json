    {
      "type": "timeseries",
      "title": "Vitals availability",
      "description": "Share of live rows with someone present that carried a heart rate, and the share of rows with a fresh calibration and with vitals authorized by the server. One bar per day in the home's time zone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', bucket AT TIME ZONE '$tz') AT TIME ZONE '$tz' AS time,\n       sum(hr_n) / nullif(sum(presence * n_live), 0) AS \"heart rate published\",\n       sum(calibration_fresh * n) / nullif(sum(n), 0) AS \"calibration fresh\",\n       sum(vitals_authorized * n) / nullif(sum(n), 0) AS \"vitals authorized\"\nFROM agg.state_1h\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
