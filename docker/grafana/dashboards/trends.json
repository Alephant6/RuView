    {
      "type": "timeseries",
      "title": "Watchdog problems",
      "description": "Hours each watchdog check was raised per day. Kept for 90 days. One bar per day in the home's time zone.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n    SELECT time, fields,\n           least(lead(time) OVER (ORDER BY time) - time, interval '5 minutes') AS dt\n    FROM ingest.watchdog\n    WHERE $__timeFilter(time)\n)\nSELECT date_trunc('day', time AT TIME ZONE '$tz') AT TIME ZONE '$tz' AS time,\n       substr(key, 7) AS metric,\n       extract(epoch FROM sum(dt)) / 3600 AS value\nFROM s, jsonb_each_text(fields) AS f(key, value)\nWHERE key LIKE 'check\\_%' AND value = '1'\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
