    {
      "type": "timeseries",
      "title": "Asleep per night (server)",
      "description": "Hours the sensing server's someone_sleeping state was on per night (21:00 to 21:00, so naps count), on the node that reported most of it. Not checked against a reference device yet (WP2.2). Kept for 90 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ruview-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ruview-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n    SELECT device, time, \"on\",\n           least(lead(time) OVER (PARTITION BY device ORDER BY time) - time,\n                 interval '5 minutes') AS dt\n    FROM ingest.ha_binary\n    WHERE entity = 'someone_sleeping' AND $__timeFilter(time)\n)\nSELECT time, max(h) AS \"asleep\"\nFROM (SELECT date_trunc('day', time AT TIME ZONE '$tz' + interval '3 hours') AT TIME ZONE '$tz' AS time,\n             device,\n             extract(epoch FROM sum(dt) FILTER (WHERE \"on\" = 1)) / 3600 AS h\n      FROM s\n      GROUP BY 1, 2) AS d\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "gradientMode": "none",
            "pointSize": 4
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
