{
  "uid": "ruview-presence",
  "title": "RuView — Presence & People",
  "description": "Per-slot and per-named-person presence + position. Use to see who's home, when, and where.",
  "tags": ["ruview", "presence"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Presence (global)",
      "type": "state-timeline",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "grey",  "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "absent" }, "1": { "text": "present" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.9, "showValue": "auto" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"state\" and r._field == \"presence\")\n  |> aggregateWindow(every: 30s, fn: max, createEmpty: false)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Person count",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 5,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"state\" and r._field == \"n_persons\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Per-slot / per-name occupancy",
      "type": "state-timeline",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "description": "One row per slot or labeled person. Shows when each was detected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "grey",  "value": null },
              { "color": "blue",  "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "—" }, "1": { "text": "here" } } }
          ]
        }
      },
      "options": { "mergeValues": true, "rowHeight": 0.85, "showValue": "auto" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"person\" and r._field == \"occupied\")\n  |> aggregateWindow(every: 30s, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"person_key\"])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Person X position",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 3 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"person\" and r._field == \"x\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"person_key\"])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Person Y position",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "auto", "pointSize": 3 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"person\" and r._field == \"y\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"person_key\"])"
        }
      ]
    },
    {
      "id": 6,
      "title": "Fall events (last 24h)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"state\" and r._field == \"fall_detected\")\n  |> filter(fn: (r) => r._value > 0)\n  |> count()"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active sensing nodes",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green",  "value": 3 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"state\" and r._field == \"active_nodes\")\n  |> last()"
        }
      ]
    },
    {
      "id": 8,
      "title": "Source",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 22 },
      "description": "Active CSI source — should be 'esp32' for the household deployment.",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*source.*/" }, "textMode": "value" },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"sensing\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"state\" and r._field == \"source\")\n  |> last()"
        }
      ]
    }
  ]
}
