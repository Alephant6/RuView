# ─────────────────────────────────────────────────────────────────────────────
#  RuView sensing-server + MQTT bridge — environment configuration
#  Copy this file to `.env` (in the same directory as docker-compose.yml) and
#  fill in your values. `.env` is read automatically by `docker compose`.
# ─────────────────────────────────────────────────────────────────────────────

# ── sensing-server ───────────────────────────────────────────────────────────

# Data source for the sensing pipeline.
#   auto       — probe UDP:5005 for an ESP32 first; fall back to simulation
#   esp32      — receive real CSI frames from ESP32 over UDP:5005 (recommended
#                once you have at least one node provisioned)
#   wifi       — host Wi-Fi RSSI/scan data (Windows host only)
#   simulated  — synthetic frames, no hardware needed
CSI_SOURCE=auto

# Where the sensing-server scans for `.rvf` model files. The compose file
# already mounts ./models into the container at /app/models — keep this unless
# you mount a different path.
MODELS_DIR=/app/models


# ── MQTT: the NAS bus and Home Assistant's broker ────────────────────────────

# Every service talks to the NAS bus (the mosquitto service, no login needed);
# the bus bridges the topics Home Assistant uses to Home Assistant's broker,
# set below. Empty MQTT_HOST runs the bus without that bridge.

# Address of Home Assistant's MQTT broker. If Home Assistant is on a different
# machine, use that machine's LAN IP (NOT homeassistant.local — mDNS often
# fails inside containers).
MQTT_HOST=192.168.1.10

# Standard ports: 1883 (plain) / 8883 (TLS). The bridge uses plain.
MQTT_PORT=1883

# The bus bridge's login on that broker. With Home Assistant's Mosquitto
# add-on these are regular HA user accounts. Create a dedicated `mqtt-bridge`
# user under Settings → People (uncheck Admin, check Local access only) and
# put its username + password here. Leave both empty for an anonymous broker.
MQTT_USER=mqtt-bridge
MQTT_PASS=change-me

# Port of the bus on the NAS loopback, for the host-network sensing-server
# and csi-recorder. Change it only if something else on the NAS uses 1883.
# MQTT_BUS_PORT=1883

# Root MQTT topic. Bridge publishes:
#   <prefix>/availability   (online/offline LWT)
#   <prefix>/state          (flat JSON for HA templates, one per new tick)
#   <prefix>/nodes/<id>     (per-node RSSI / CSI fps / stale flag)
#   <prefix>/person/<slot>  (per-person slots, on change)
#   <prefix>/event          (one-shot fall events)
#   <prefix>/bridge         (bridge stream health, retained)
# The analytics watchdog publishes <prefix>/watchdog/{state,metrics,availability};
# the csi-recorder <prefix>/recorder/{status,availability,keep/result}; the HA
# label buttons <prefix>/annotation and <prefix>/recorder/keep.
MQTT_PREFIX=ruview

# HA Discovery prefix — must match the "Discovery prefix" setting of HA's
# MQTT integration (default `homeassistant`). Change only if you customised
# HA's MQTT discovery prefix.
HA_DISCOVERY_PREFIX=homeassistant

# Friendly name shown in HA's Devices list.
DEVICE_NAME=RuView Sensing

# Unique device id (also used as the prefix of every entity's unique_id).
# Change if you run more than one RuView instance against the same HA.
DEVICE_ID=ruview

# Bridge publish limits in Hz (0 = no limit): <prefix>/state for new ticks up
# to STATE_MAX_HZ, each <prefix>/nodes/<id> up to NODE_MAX_HZ, person slots
# on change up to PERSON_MAX_HZ.
# STATE_MAX_HZ=10
# NODE_MAX_HZ=1
# PERSON_MAX_HZ=1


# ── analytics (data watchdog) ───────────────────────────────────────────────

# Sensing-server REST API the watchdog reads (GET only, plus the calibration
# calls of automatic calibration below), with the same RUVIEW_API_TOKEN as
# the server, and the node ids that should be online.
# RUVIEW_HTTP=http://192.168.1.195:3000
# EXPECTED_NODES=1,2,3

# Optional "presence vs phones" check: Home Assistant URL, a long-lived
# access token (HA profile -> Security) and the person entities to compare.
# HA_URL=http://192.168.1.10:8123
# HA_TOKEN=
# HA_PERSONS=person.alice,person.bob

# Language of the watchdog's messages in HA: zh or en
# WATCHDOG_LANG=zh

# On a new frozen-vitals, implausible-vitals or presence problem, ask the
# csi-recorder to keep the raw CSI of the minutes before it (0 = off).
# KEEP_ON_RAISE_MIN=20

# Automatic empty-room calibration (analytics/README.md). Off unless
# AUTOCAL_SOURCE_NODE is set to the node the calibration is taken from (one
# of EXPECTED_NODES). Needs HA_URL / HA_TOKEN / HA_PERSONS above: it only
# calibrates while every phone has been away AUTOCAL_AWAY_MIN minutes and the
# room is quiet. A fresh calibration older than AUTOCAL_REFRESH_H hours
# (1-12; 12 = never early) is replaced. AUTOCAL_MAX_MOVING is the largest
# share of "moving" room states tolerated before and during a capture.
# AUTOCAL_SOURCE_NODE=
# AUTOCAL_AWAY_MIN=10
# AUTOCAL_REFRESH_H=6
# AUTOCAL_MAX_MOVING=0.25


# ── csi-recorder (raw CSI, WP0.5) ────────────────────────────────────────────

# The sensing-server copies every admitted UDP datagram to this loopback
# address (ADR-380); the recorder listens there. Empty switches the copy off.
# RUVIEW_UDP_TEE=127.0.0.1:5006
# RECORDER_LISTEN=127.0.0.1:5006

# Host directory for recordings (raw CSI is person data; keep it on the NAS).
# Must be writable by uid 65534 (csi-recorder/README.md shows how without sudo).
# CSI_DATA_DIR=./data/csi

# Rolling window and its size cap, and the free space below which recording
# pauses.
# RING_HOURS=72
# RING_MAX_GB=20
# MIN_FREE_GB=2

# Permanent clips: longest single clip and total per UTC day.
# KEEP_MAX_MIN=120
# KEEP_MAX_H_PER_DAY=2

# The watchdog and the recorder use LOG_LEVEL below as well.


# ── TimescaleDB (WP1.1, docker/timescaledb/README.md) ───────────────────────

# Superuser and service-role passwords, each generated with
#   openssl rand -hex 24
# The superuser password is fixed when the database volume is first created.
# A role whose password is empty cannot log in.
POSTGRES_PASSWORD=
PG_TELEGRAF_PASSWORD=
PG_GRAFANA_PASSWORD=
# PG_ANALYTICS_PASSWORD=
# PG_LLM_RO_PASSWORD=

# The database listens on the NAS loopback only; reach it through an ssh
# tunnel, or set PG_BIND to the NAS LAN address to open it to the LAN.
# PG_BIND=127.0.0.1
# PG_PORT=5432
# PG_PORT must be free on the NAS, whose own services may already use 5432
# and others (check with `ss -ltn`); the home NAS uses 5455.

# Memory and CPUs Postgres is sized for when the volume is first created.
# PG_MEMORY=1GB
# PG_CPUS=2

# Bridge log verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Apple Watch ingest (docker-compose.health.yml): one token per person, >= 16 chars.
# HEALTH_TOKENS=sq:change-me-token-1,ml:change-me-token-2
# HEALTH_INGEST_PORT=8095
# HEALTH_INGEST_BIND=192.168.1.195
